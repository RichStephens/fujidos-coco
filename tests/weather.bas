10 REM CURRENT WEATHER WHERE IP-API.COM PLACES THIS FUJINET, FROM OPEN-METEO
20 CLEAR 1000:CLS
30 PRINT "FINDING YOUR LOCATION..."
40 OPEN "I",#1,"N:http://ip-api.com/json/?fields=status,city,regionName,countryCode,lat,lon"
50 JSONPARSE #1
60 IF JSONQUERY$(1,"/status")<>"success" THEN CLOSE #1:PRINT "LOCATION LOOKUP FAILED":END
70 PL$=UCASE$(JSONQUERY$(1,"/city")+", "+JSONQUERY$(1,"/regionName")+" "+JSONQUERY$(1,"/countryCode"))
80 LA$=JSONQUERY$(1,"/lat"):LO$=JSONQUERY$(1,"/lon")
90 CLOSE #1
100 PRINT "GETTING THE WEATHER..."
110 U$="N:https://api.open-meteo.com/v1/forecast?latitude="+LA$+"&longitude="+LO$+"&timezone=auto"
120 U$=U$+"&current=temperature_2m,apparent_temperature,relative_humidity_2m,wind_speed_10m,weather_code"
130 U$=U$+"&temperature_unit=fahrenheit&wind_speed_unit=mph"
140 OPEN "I",#1,U$
150 JSONPARSE #1
160 T$=JSONQUERY$(1,"/current/temperature_2m"):F$=JSONQUERY$(1,"/current/apparent_temperature")
170 H$=JSONQUERY$(1,"/current/relative_humidity_2m"):W$=JSONQUERY$(1,"/current/wind_speed_10m")
180 WC=VAL(JSONQUERY$(1,"/current/weather_code")):TM$=JSONQUERY$(1,"/current/time")
190 CLOSE #1
200 IF T$="" THEN PRINT "WEATHER LOOKUP FAILED":END
210 RESTORE
220 READ N,D$:IF N<>WC AND N>=0 THEN 220
230 IF LEN(TM$)>10 THEN MID$(TM$,11,1)=" "
240 CLS:PRINT "WEATHER FOR":PRINT PL$:PRINT
250 PRINT "CONDITIONS:  ";D$
260 PRINT "TEMPERATURE: ";T$;" F"
270 PRINT "FEELS LIKE:  ";F$;" F"
280 PRINT "HUMIDITY:    ";H$;"%"
290 PRINT "WIND:        ";W$;" MPH"
300 PRINT:PRINT "AS OF ";TM$
310 END
800 DATA 0,CLEAR,1,MAINLY CLEAR,2,PARTLY CLOUDY,3,OVERCAST,45,FOG,48,FREEZING FOG
810 DATA 51,LIGHT DRIZZLE,53,DRIZZLE,55,HEAVY DRIZZLE,56,FREEZING DRIZZLE,57,FREEZING DRIZZLE
820 DATA 61,LIGHT RAIN,63,RAIN,65,HEAVY RAIN,66,FREEZING RAIN,67,FREEZING RAIN
830 DATA 71,LIGHT SNOW,73,SNOW,75,HEAVY SNOW,77,SNOW GRAINS
840 DATA 80,LIGHT SHOWERS,81,SHOWERS,82,HEAVY SHOWERS,85,SNOW SHOWERS,86,HEAVY SNOW SHOWERS
850 DATA 95,THUNDERSTORM,96,THUNDERSTORM WITH HAIL,99,THUNDERSTORM WITH HAIL,-1,UNKNOWN
