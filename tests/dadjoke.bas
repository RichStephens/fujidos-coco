10 REM A RANDOM JOKE FROM ICANHAZDADJOKE.COM
20 CLEAR 1000:SW=32
24 REM COCO 3 WIDTH 40 OR 80
25 IF PEEK(&HFFFC)=&HFE THEN W=PEEK(&HE7) ELSE W=0
26 IF W=1 THEN SW=40 ELSE IF W=2 THEN SW=80
30 CLS:PRINT "GETTING A JOKE..."
40 OPEN "D",#1,"N:https://icanhazdadjoke.com/"
50 HEADER #1,"Accept: application/json"
60 JSONPARSE #1:A$=JSONQUERY$(1,"/joke"):CLOSE #1
70 IF A$="" THEN PRINT "NO JOKE TODAY":GOTO 200
80 IF SW=32 THEN A$=UCASE$(A$):REM LOWERCASE SHOWS AS INVERSE AT 32 COLUMNS
90 CLS
100 REM A LINE AT A TIME, BROKEN AT SPACES
105 P=1:L=LEN(A$):N=SW-1
110 IF P>L THEN 200
120 IF L-P<N THEN PRINT MID$(A$,P):GOTO 200
130 B=P+N
140 IF B>P AND MID$(A$,B,1)<>" " THEN B=B-1:GOTO 140
150 IF B=P THEN B=P+N
160 PRINT MID$(A$,P,B-P):P=B
170 IF MID$(A$,P,1)=" " THEN P=P+1:GOTO 170
180 GOTO 110
200 PRINT:PRINT "PRESS A KEY FOR ANOTHER"
210 IF INKEY$="" THEN 210
220 GOTO 30
