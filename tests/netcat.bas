10 REM A SMALL NETCAT: BREAK TO QUIT
20 CLEAR 1000:D$="N:TELNET://BBS.FOZZTEXX.COM:23/":SW=32:SH=16
24 REM COCO 3 WIDTH 40 OR 80
25 IF PEEK(&HFFFC)=&HFE THEN W=PEEK(&HE7) ELSE W=0
26 IF W=1 THEN SW=40:SH=24 ELSE IF W=2 THEN SW=80:SH=24
30 PRINT "ENTER URL, OR ENTER FOR":PRINT D$:LINE INPUT U$:IF U$="" THEN U$=D$
34 REM TELL A TELNET HOST THE SCREEN SIZE
35 IF INSTR(U$,"?")=0 AND INSTR(UCASE$(U$),"TELNET://")>0 THEN U$=U$+"?cols="+MID$(STR$(SW),2)+"&rows="+MID$(STR$(SH),2)
40 OPEN "D",#1,U$,1
50 IF EOF(1) THEN PRINT:PRINT "CLOSED":CLOSE #1:END
60 PRINT NREAD$(1,255);
70 K$=INKEY$:IF K$<>"" THEN PRINT #1,K$;
80 GOTO 50
