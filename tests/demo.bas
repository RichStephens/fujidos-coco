10 REM A TOUR OF FUJIDOS, ONE GROUP OF FEATURES PER MENU CHOICE
20 CLEAR 2000
30 IF PEEK(&HFFFC)=&HFE THEN WIDTH 32
40 H$="N:https://httpbin.org/":Q$=CHR$(34)
100 CLS:PRINT "       A TOUR OF FUJIDOS":PRINT
110 PRINT " 1 CLOCK AND FUJINET INFO"
120 PRINT " 2 STRING FUNCTIONS"
130 PRINT " 3 READING FROM THE NETWORK"
140 PRINT " 4 WEB APIS: JSON, XML, HTML"
150 PRINT " 5 QR CODES"
160 PRINT " 6 DISKS AND PRINTER"
170 PRINT " 7 SYSTEM COMMANDS"
180 PRINT " Q QUIT":PRINT:PRINT "YOUR CHOICE? ";
200 K$=INKEY$:IF K$="" THEN 200
210 IF K$="Q" THEN CLS:END
220 K=VAL(K$):IF K<1 OR K>7 THEN 200
230 ON K GOSUB 1000,2000,3000,4000,5000,6000,7000
240 GOTO 100
1000 T$="CLOCK AND FUJINET INFO":GOSUB 9000
1010 PRINT "THE FUJINET SUPPLIES THESE."
1020 PRINT "EACH IS EMPTY IF IT IS OFFLINE.":PRINT
1030 PRINT "TIME$ = ";TIME$
1040 PRINT "DATE$ = ";DATE$
1050 PRINT "IP$   = ";IP$
1060 PRINT:PRINT "GUID$, A NEW ONE EACH TIME:":PRINT GUID$
1070 PRINT:PRINT "THEY CAN BE READ BUT NOT SET."
1080 GOTO 9100
2000 T$="STRING FUNCTIONS":GOSUB 9000
2010 A$="  Hello, World  ":B$="RED,GREEN,BLUE"
2020 PRINT "A$ = [";A$;"]"
2030 PRINT "UCASE$(A$)":PRINT "  [";UCASE$(A$);"]"
2040 PRINT "LCASE$(A$)":PRINT "  [";LCASE$(A$);"]"
2050 PRINT "TRIM$(A$)":PRINT "  [";TRIM$(A$);"]"
2060 PRINT "URLENCODE$(TRIM$(A$))":PRINT "  ";URLENCODE$(TRIM$(A$))
2070 PRINT "FIELD$(";Q$;B$;Q$;",2,";Q$;",";Q$;")":PRINT "  ";FIELD$(B$,2,",")
2080 PRINT "(LOWERCASE SHOWS AS INVERSE)"
2090 GOTO 9100
3000 T$="READING FROM THE NETWORK":GOSUB 9000
3010 PRINT "A FILE NAME STARTING N: OPENS A"
3020 PRINT "URL ON A FILE NUMBER. THEN USE"
3030 PRINT "LINE INPUT #, EOF, LOF, CLOSE."
3040 PRINT:PRINT "OPEN ";Q$;"I";Q$;",#1,";Q$;"N:HTTPS://"
3050 PRINT "  HTTPBIN.ORG/ROBOTS.TXT";Q$:PRINT
3060 OPEN "I",#1,H$+"robots.txt"
3070 PRINT "LOF(1) =";LOF(1);"BYTES WAITING"
3080 IF EOF(1) THEN 3100
3090 LINE INPUT #1,A$:PRINT "> ";UCASE$(A$):GOTO 3080
3100 PRINT "NETERR(1) =";NETERR(1);"(136 = END)"
3110 CLOSE #1:GOSUB 9100
3200 T$="MORE ON NETWORK FILES":GOSUB 9000
3210 PRINT "OPEN MODES:"
3220 PRINT " I READ (HTTP GET)"
3230 PRINT " O WRITE (HTTP PUT)"
3240 PRINT " D BOTH WAYS (GET, TCP)"
3250 PRINT " P HTTP POST   K HTTP DELETE"
3260 PRINT:PRINT "NREAD$(F,N) READS UP TO N RAW"
3270 PRINT "BYTES, FOR BINARY DATA:"
3280 OPEN "I",#1,H$+"base64/AA0K_4B__gEA",0
3290 A$=NREAD$(1,255):CLOSE #1
3300 IF A$="" THEN PRINT " NO DATA":GOTO 3320
3310 FOR I=1 TO LEN(A$):PRINT ASC(MID$(A$,I,1));:NEXT:PRINT
3320 PRINT:PRINT "N1: TO N8: PICK ONE OF 8 UNITS,"
3330 PRINT "SO SEVERAL CAN BE OPEN AT ONCE."
3340 GOTO 9100
4000 T$="WEB APIS: JSON":GOSUB 9000
4010 PRINT "HEADER # ADDS A REQUEST HEADER."
4020 PRINT "JSONPARSE # READS THE REPLY AND"
4030 PRINT "JSONQUERY$ PICKS VALUES OUT."
4040 PRINT:PRINT "FROM ICANHAZDADJOKE.COM:":PRINT
4050 OPEN "D",#1,"N:https://icanhazdadjoke.com/"
4060 HEADER #1,"Accept: application/json"
4070 JSONPARSE #1:A$=UCASE$(JSONQUERY$(1,"/joke")):CLOSE #1
4080 IF A$="" THEN A$="NO JOKE TODAY"
4090 GOSUB 9200:GOSUB 9100
4100 T$="WEB APIS: POSTING A FORM":GOSUB 9000
4110 PRINT "MODE P POSTS WHAT YOU PRINT #,"
4120 PRINT "THEN YOU READ THE REPLY.":PRINT
4130 LINE INPUT "YOUR NAME? ";N$
4140 OPEN "P",#1,H$+"post":HEADER #1,"Content-Type: application/x-www-form-urlencoded"
4150 PRINT #1,"name="+URLENCODE$(N$);:JSONPARSE #1
4160 PRINT:PRINT "SENT: NAME=";URLENCODE$(N$)
4170 PRINT "HTTPBIN.ORG SAW:":PRINT " ";JSONQUERY$(1,"/form/name")
4180 CLOSE #1:GOSUB 9100
4200 T$="WEB APIS: XML AND HTML":GOSUB 9000
4210 PRINT "XMLPARSE # AND HTMLPARSE # WORK"
4220 PRINT "THE SAME WAY, WITH XMLQUERY$"
4230 PRINT "AND HTMLQUERY$.":PRINT
4240 OPEN "I",#1,H$+"xml":XMLPARSE #1
4250 PRINT "XML /SLIDESHOW/@TITLE:":PRINT " ";UCASE$(XMLQUERY$(1,"/slideshow/@title")):CLOSE #1
4260 OPEN "I",#1,H$+"html":HTMLPARSE #1
4270 PRINT "HTML H1:":PRINT " ";UCASE$(HTMLQUERY$(1,"h1")):CLOSE #1
4280 GOTO 9100
5000 T$="QR CODES":GOSUB 9000
5010 PRINT "QRCODE DRAWS TEXT AS A QR CODE"
5020 PRINT "ON THE 32-COLUMN SCREEN, FOR A"
5030 PRINT "PHONE TO SCAN. IT DRAWS BLACK"
5040 PRINT "ON BUFF, SO USE CLS 5 FIRST.":PRINT
5050 PRINT "CLS 5":PRINT "QRCODE ";Q$;"HTTPS://FUJINET.ONLINE";Q$
5060 PRINT:PRINT "QRCODE @POS,TEXT PUTS ITS TOP"
5070 PRINT "LEFT AT A PRINT @ POSITION."
5080 GOSUB 9100
5090 CLS 5:QRCODE "HTTPS://FUJINET.ONLINE":PRINT@453,"HTTPS://FUJINET.ONLINE";
5100 IF INKEY$="" THEN 5100
5110 RETURN
6000 T$="DISKS":GOSUB 9000
6010 PRINT "THE FUJINET HAS 4 DRIVES, #0 TO"
6020 PRINT "#3, EACH HOLDING A DISK IMAGE."
6030 PRINT:PRINT "BACKUP #0 TO #1"
6040 PRINT " COPIES DRIVE 0'S IMAGE TO THE"
6050 PRINT " SD CARD AND MOUNTS IT IN #1."
6060 PRINT "DSKINI #1,";Q$;"WORK";Q$
6070 PRINT " MAKES A BLANK WORK.DSK ON THE"
6080 PRINT " SD CARD AND MOUNTS IT IN #1."
6090 PRINT "COPY ";Q$;"A.BAS:#0";Q$;" TO #1"
6100 PRINT " COPIES A FILE BETWEEN DRIVES."
6110 PRINT "(NOT RUN: THEY WRITE TO THE SD)"
6130 GOSUB 9100
6200 T$="PRINTER":GOSUB 9000
6210 PRINT "FPRINT ON SENDS PRINT #-2 AND"
6220 PRINT "LLIST TO THE FUJINET PRINTER."
6230 PRINT "GET THE PAGES FROM THE FUJINET"
6240 PRINT "WEB PAGE. FPRINT OFF GOES BACK"
6250 PRINT "TO THE SERIAL PORT."
6260 PRINT:PRINT "PRINT A TEST PAGE NOW (Y/N)? ";
6270 K$=INKEY$:IF K$="" THEN 6270
6280 IF K$<>"Y" THEN RETURN
6290 FPRINT ON:PRINT #-2,"HELLO FROM FUJIDOS":PRINT #-2,DATE$;" ";TIME$:FPRINT OFF
6300 PRINT:PRINT:PRINT "SENT.":GOTO 9100
7000 T$="SYSTEM COMMANDS":GOSUB 9000
7010 PRINT "CPUSPEED SHOWS A COCO 3'S SPEED"
7020 PRINT "CPUSPEED HI OR LO SETS IT."
7030 PRINT "RIGHT NOW IT IS: ";:CPUSPEED
7040 PRINT:PRINT "CONFIG REBOOTS INTO THE FUJINET"
7050 PRINT "CONFIG PROGRAM, TO PICK DISKS."
7060 PRINT "LOBBY REBOOTS INTO THE FUJINET"
7070 PRINT "GAME LOBBY."
7080 PRINT:PRINT "FUJIDOS WORDS ARE RESERVED LIKE"
7090 PRINT "BASIC'S: CONFIG=1 IS AN ERROR."
7100 PRINT@480,"C = RUN CONFIG, ELSE THE MENU";
7110 K$=INKEY$:IF K$="" THEN 7110
7120 IF K$="C" THEN CONFIG
7130 RETURN
8990 REM TITLE T$
9000 CLS:PRINT T$:PRINT STRING$(LEN(T$),"-"):RETURN
9090 REM WAIT FOR A KEY
9100 PRINT@490,"PRESS A KEY";
9110 IF INKEY$="" THEN 9110
9120 RETURN
9190 REM PRINT A$ BROKEN AT SPACES
9200 P=1:L=LEN(A$):N=31
9210 IF P>L THEN RETURN
9220 IF L-P<N THEN PRINT MID$(A$,P):RETURN
9230 B=P+N
9240 IF B>P AND MID$(A$,B,1)<>" " THEN B=B-1:GOTO 9240
9250 IF B=P THEN B=P+N
9260 PRINT MID$(A$,P,B-P):P=B
9270 IF MID$(A$,P,1)=" " THEN P=P+1:GOTO 9270
9280 GOTO 9210
