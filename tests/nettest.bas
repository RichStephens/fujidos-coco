10 REM FUJIDOS NETWORK FEATURE TESTS, AGAINST HTTPBIN.ORG
20 CLEAR 1000:CLS:P=0:F=0
30 H$="N:https://httpbin.org/"
40 PRINT "FUJIDOS NETWORK TESTS":PRINT
100 REM CLOCK, GUID AND UCASE$
110 T$="TIME$":R=(LEN(TIME$)=8):GOSUB 900
120 T$="DATE$":R=(LEN(DATE$)=10):GOSUB 900
130 T$="GUID$":R=(LEN(GUID$)=36):GOSUB 900
140 T$="UCASE$":R=(UCASE$("az{@`Zq1")="AZ{@`ZQ1" AND UCASE$("")=""):GOSUB 900
200 REM PLAIN GET
210 OPEN "I",#1,H$+"robots.txt"
215 T$="NETERR OK":R=(NETERR(1)=1):GOSUB 900
216 T$="NETERR(0) OK":R=(NETERR(0)=1):GOSUB 900
220 T$="LOF":R=(LOF(1)>0):GOSUB 900
230 LINE INPUT #1,A$:T$="LINE INPUT":R=(A$="User-agent: *"):GOSUB 900
240 LINE INPUT #1,A$:T$="LAST LINE AND EOF":R=(A$="Disallow: /deny" AND EOF(1)):GOSUB 900
245 T$="NETERR AT EOF":R=(NETERR(1)=136):GOSUB 900
246 T$="LOC AT EOF":R=(LOC(1)=0):GOSUB 900
250 CLOSE #1
260 OPEN "I",#1,H$+"status/404":T$="NETERR 404":R=(NETERR(1)=170):GOSUB 900:CLOSE #1
270 OPEN "I",#1,"WEATHER.BAS":T$="DISK FILE LOC":R=(LOC(1)>0):GOSUB 900:CLOSE #1
300 REM HEADER ON A GET, READ BACK AS JSON
310 OPEN "D",#1,H$+"headers":HEADER #1,"X-Test: fujidos":JSONPARSE #1
320 T$="HEADER, JSONQUERY$":R=(JSONQUERY$(1,"/headers/X-Test")="fujidos"):GOSUB 900
330 CLOSE #1
340 REM THE FIRMWARE'S OWN USER-AGENT (FUJINET-FIRMWARE PR 2360)
350 OPEN "I",#1,H$+"user-agent":JSONPARSE #1
360 T$="USER-AGENT":R=(LEFT$(JSONQUERY$(1,"/user-agent"),8)="FujiNet/"):GOSUB 900
370 CLOSE #1
400 REM POST A FORM
410 OPEN "P",#1,H$+"post":HEADER #1,"Content-Type: application/x-www-form-urlencoded"
420 PRINT #1,"a=1&b=two";:JSONPARSE #1
430 T$="POST":R=(JSONQUERY$(1,"/form/b")="two"):GOSUB 900
440 CLOSE #1
500 REM DELETE
510 OPEN "K",#1,H$+"delete":JSONPARSE #1
520 T$="DELETE":R=(JSONQUERY$(1,"/url")="https://httpbin.org/delete"):GOSUB 900
530 CLOSE #1
600 REM XML AND HTML
610 OPEN "I",#1,H$+"xml":XMLPARSE #1
620 T$="XMLQUERY$":R=(XMLQUERY$(1,"/slideshow/@title")="Sample Slide Show"):GOSUB 900
630 CLOSE #1
640 OPEN "I",#1,H$+"html":HTMLPARSE #1
650 T$="HTMLQUERY$":R=(HTMLQUERY$(1,"h1")="Herman Melville - Moby-Dick"):GOSUB 900
660 CLOSE #1
700 REM TWO NETWORK FILES AT ONCE, ON UNITS 2 AND 3
710 OPEN "I",#1,"N2:https://httpbin.org/robots.txt":OPEN "I",#2,"N3:https://httpbin.org/robots.txt"
720 LINE INPUT #1,A$:LINE INPUT #2,B$
730 T$="TWO FILES":R=(A$=B$ AND A$="User-agent: *"):GOSUB 900
740 CLOSE #1,#2
800 PRINT:PRINT P;"PASSED,";F;"FAILED":END
890 REM A DOT FOR A PASS, A LINE FOR A FAILURE
900 IF R THEN P=P+1:PRINT ".";:RETURN
910 F=F+1:PRINT:PRINT "FAIL ";T$:RETURN
